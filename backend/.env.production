# PRODUCTION ENVIRONMENT CONFIGURATION

# Switch to standard environment
NODE_ENV="production"
PORT=4000

# -----------------------------------------------------------------------------
# ⚠️ POSTGRESQL MIGRATION SETTINGS
# We have migrated the Prisma schema from SQLite to PostgreSQL for production.
# Replace the URL below with your actual PostgreSQL connection string.
# Example platforms: Vercel Postgres, Supabase, Neon, AWS RDS.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@hostname:5432/driveflow_db?schema=public"

# Auth Secret (Use a strong generated 64-character hex in production)
JWT_SECRET="production_super_secret_driveflow_key"

# CORS Origin Config
CORS_ORIGIN="https://your-production-domain.com"
