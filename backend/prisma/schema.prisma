generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Fleet Manager")
  role         String   @default("user")
  dealership   String   @default("Global Motors")
  avatar       String   @default("")
  createdAt    DateTime @default(now())
}

model Vehicle {
  id           String   @id @default(cuid())
  make         String
  model        String
  trim         String   @default("Base")
  year         Int      @default(2024)
  category     String
  vin          String   @default("")
  dealerId     String   @default("GM-001")
  price        Int
  quantity     Int
  status       String   @default("In Stock")
  image        String   @default("")
  mileage      Int      @default(0)
  color        String   @default("")
  fuelType     String   @default("Gasoline")
  transmission String   @default("Automatic")
  description  String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Purchase {
  id          String   @id @default(cuid())
  userId      String
  userEmail   String
  userName    String
  vehicleId   String
  make        String
  model       String
  price       Int
  purchasedAt DateTime @default(now())
}

